      "title": "¿Cuáles son los síntomas del dengue?",
      "messages": [
        {
          "role": "user",
          "content": "¿Cuáles son los síntomas del dengue?",
          "sentAt": "2026-06-18T15:02:00.000Z"
        },
        {
          "role": "assistant",
          "content": "El dengue suele presentar fiebre alta, dolor de cabeza intenso, dolor detrás de los ojos, dolores musculares y articulares, y a veces erupción en la piel. Ante fiebre alta persistente o señales de alarma (sangrado, dolor abdominal fuerte, vómitos constantes), acude de inmediato a un centro de salud.",
          "sentAt": "2026-06-18T15:02:04.000Z"
        }
      ],
      "createdAt": "2026-06-18T15:02:00.000Z",
      "updatedAt": "2026-06-18T15:02:04.000Z"
    }
